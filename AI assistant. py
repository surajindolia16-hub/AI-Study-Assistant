# -------------------------------------------------------
# CORE MATHEMATICAL VECTOR ENGINE (SURAJ'S CORE LOGIC)
# -------------------------------------------------------
def build_vocabulary(corpus):
    vocab = set()
    for document in corpus:
        words = document.lower().replace(".", "").replace(":", "").split()
        for word in words:
            vocab.add(word)
    return sorted(list(vocab))

def text_to_vector(text, vocab):
    vector = [0] * len(vocab)
    words = text.lower().replace(".", "").replace(":", "").split()
    for word in words:
        if word in vocab:
            vocab_index = vocab.index(word)
            vector[vocab_index] += 1
    return vector

def calculate_cosine_similarity(vec1, vec2):
    dot_product = 0
    norm_a = 0
    norm_b = 0
    for i in range(len(vec1)):
        dot_product += vec1[i] * vec2[i]
        norm_a += vec1[i] ** 2
        norm_b += vec2[i] ** 2
    if norm_a == 0 or norm_b == 0:
        return 0.0
    return dot_product / (math.sqrt(norm_a) * math.sqrt(norm_b))

vocabulary = build_vocabulary(study_notes)

# -------------------------------------------------------
# GOOGLE AI COGNITIVE PIPELINE
# -------------------------------------------------------
def ask_google_gemini_smart_summary(context_paragraph, user_query):
    if not GEMINI_AVAILABLE or GEMINI_API_KEY == "YOUR_GEMINI_API_KEY":
        return "\n[⚠️ Google AI System Notification]: Running in Standalone Offline Verification Mode. (Add Gemini API Key to enable cloud insights)."
    
    prompt = f"""
    You are a backend component inside 'AI Study Assistant Pro' built by Suraj Indoliya.
    The local math engine has successfully filtered this context paragraph:
    "{context_paragraph}"
    
    The student asked this specific question:
    "{user_query}"
    
    Your Job: Summarize the answer beautifully and add 1 short multiple-choice quiz question at the end based ONLY on the context. Keep it highly educational and extremely concise.
    """
    try:
        response = ai_model.generate_content(prompt)
        return response.text
    except Exception as e:
        return f"Error linking with Google AI Framework: {str(e)}"

