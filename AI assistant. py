    def log_to_console(self, text):
        self.console_output.insert(tk.END, text + "\n")
        self.console_output.see(tk.END)

    def process_search(self):
        query = self.query_entry.get().strip()
        if not query:
            messagebox.showwarning("Input Error", "Please enter a question to query the database!")
            return
            
        self.console_output.delete("1.0", tk.END) # Clear previous log
        self.log_to_console(f"🔍 [Query Captured]: '{query}'")
        
        # 1. Math Pipeline Engine Starts
        query_vector = text_to_vector(query, vocabulary)
        best_similarity = -1
        best_match_index = -1
        
        for idx, note in enumerate(study_notes):
            note_vector = text_to_vector(note, vocabulary)
            similarity = calculate_cosine_similarity(query_vector, note_vector)
            if similarity > best_similarity:
                best_similarity = similarity
                best_match_index = idx
                
        self.log_to_console(f"📊 [Suraj's Math Engine]: Calculated Best Cosine Match Distance = {best_similarity:.4f}")
        
        if best_similarity > 0.05:
            matched_note = study_notes[best_match_index]
            self.log_to_console(f"📖 [Local Context Matrix Hit]: {matched_note}\n")
            
            # 2. Feeding to Google AI Framework
            self.log_to_console("🚀 Executing Google Gemini AI Cloud Bridge Sequence...")
            self.root.update() # Refresh UI
            
            ai_response = ask_google_gemini_smart_summary(matched_note, query)
            
            self.log_to_console("\n=======================================================")
            self.log_to_console("🤖 [GOOGLE GEMINI GENERATIVE SYNTHESIS]:")
            self.log_to_console(ai_response)
            self.log_to_console("=======================================================")
        else:
            self.log_to_console("❌ [Search Fault]: Cosine distance below threshold. No matching context found in local core layers.")

