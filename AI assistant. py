print("=== AI Study Assistant ===")

notes = []

while True:
    print("\n1. Add Note")
    print("2. View Notes")
    print("3. Ask AI")
    print("4. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        note = input("Write your note: ")
        notes.append(note)
        print("Note saved!")

    elif choice == "2":
        print("\nYour Notes:")
        for i, n in enumerate(notes, start=1):
            print(f"{i}. {n}")

    elif choice == "3":
        question = input("Ask something: ").lower()

        if "python" in question:
            print("Python is a powerful programming language.")
        elif "ai" in question:
            print("AI means Artificial Intelligence.")
        elif "hello" in question:
            print("Hello! How can I help you?")
        else:
            print("Sorry, I don't know that yet.")

    elif choice == "4":
        print("Goodbye!")
        break

    else:
        print("Invalid choice.")