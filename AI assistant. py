def ask_google_gemini_smart_summary(context_paragraph, user_query):
    """
    Yeh function hamare math engine ke result ko leta hai aur 
    Google Gemini AI ko bhejkar ek super smart smart-study response generate karta hai.
    """
    if not GEMINI_AVAILABLE:
        return "\n[⚠️ Google AI Info]: API Key missing or Google AI module offline. Displaying raw local vector match only."
    
    prompt = f"""
    You are an AI Study Assistant Pro built by Suraj Indoliya for the Google AI Hackathon.
    
    Context from student's notes:
    "{context_paragraph}"
    
    Student's Question:
    "{user_query}"
    
    Instructions:
    Based ONLY on the provided context, answer the student's question in a crisp, clear, and engaging educational format. 
    Add a tiny 'Smart Quiz Question' at the end to help the student test their knowledge. Keep it concise.
    """
    try:
        response = ai_model.generate_content(prompt)
        return f"\n🤖 [Google Gemini AI Smart Insights]:\n{response.text}"
    except Exception as e:
        return f"\n[-] Failed to connect to Google AI Services: {str(e)}"

