                    best_match_index = idx
            
            print(f"\n⚡ [Backend Search Hit]: Best Cosine Distance Score = {best_similarity:.4f}")
            
            if best_similarity > 0.05:
                matched_note = study_notes[best_match_index]
                print(f"📖 [Local Context Retrieved]: {matched_note}")
                
                # BINDING LAYER: Pure Math Engine output goes directly into Google Gemini AI
                print("\nConnecting to Google AI pipeline for advanced synthesis...")
                ai_response = ask_google_gemini_smart_summary(matched_note, query)
                print(ai_response)
            else:
                print("❌ No relevant local study notes found matching those terms.")
                
        elif choice == "2":
            print("\n===== CURRENT LOCAL STUDY LOGS =====")
